#!/usr/bin/env bash
set -euo pipefail

sha="${1:-}"
if [[ ! "$sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo 'Expected a full Git commit SHA' >&2
  exit 2
fi

export PATH=/opt/node/v22.21.1/bin:/usr/bin:/bin
export COREPACK_HOME=/home/deploy/.cache/corepack
base=/srv/apps/bnos-svelte
release="$base/releases/$sha"
current="$base/current"
previous=$(readlink "$current")

if [[ ! -d "$release" ]]; then
  staging="$base/releases/.staging-$sha"
  rm -rf "$staging"
  mkdir "$staging"
  trap 'rm -rf "$staging"' EXIT
  git -C "$staging" init -q
  git -C "$staging" fetch -q --depth=1 https://github.com/bitoslabs/bnos-svelte.git "$sha"
  git -C "$staging" checkout -q --detach FETCH_HEAD
  [[ "$(git -C "$staging" rev-parse HEAD)" == "$sha" ]]
  if [[ -f "$base/.env" ]]; then
    ln -s "$base/.env" "$staging/.env"
  fi
  (cd "$staging" && corepack pnpm install --frozen-lockfile && corepack pnpm build)
  mv "$staging" "$release"
  trap - EXIT
fi

ln -s "$release" "$base/.current-next"
mv -Tf "$base/.current-next" "$current"
healthy=false
if sudo /usr/bin/systemctl restart bnos-svelte.service; then
  for attempt in {1..30}; do
    if curl -g -fsS --max-time 2 -o /dev/null 'http://[::1]:5174/' 2>/dev/null; then
      healthy=true
      break
    fi
    sleep 1
  done
fi
if [[ "$healthy" != true ]]; then
  ln -s "$previous" "$base/.current-rollback"
  mv -Tf "$base/.current-rollback" "$current"
  sudo /usr/bin/systemctl restart bnos-svelte.service
  echo 'Deployment failed; previous release restored' >&2
  exit 1
fi

active_release=$(readlink -f "$current")
kept=1
cd "$base"
while IFS= read -r old_release; do
  [[ "$old_release" == "$active_release" ]] && continue
  if (( kept < 3 )); then
    (( kept += 1 ))
  else
    rm -rf -- "$old_release"
  fi
done < <(find "$base/releases" -mindepth 1 -maxdepth 1 -type d -not -name '.staging-*' -printf '%T@ %p\n' | sort -nr | cut -d' ' -f2-)

echo "Deployed $sha"
