# ── Media uploads (server fallback) ──────────────────────────────────────────
# Optional. When a user does NOT configure their own Cloudinary or S3 account in
# Settings → Media & uploads, BNOS can upload media through this server and
# forward it to Cloudinary (signing server-side so the secret never reaches the
# browser). Leave blank to keep BNOS fully local-first with no server uploads.
#
# You need BNOS_CLOUDINARY_CLOUD_NAME plus either:
#   • BNOS_CLOUDINARY_UPLOAD_PRESET for unsigned uploads, or
#   • BNOS_CLOUDINARY_API_KEY + BNOS_CLOUDINARY_API_SECRET for signed uploads
#
# Uploads are organized into folders like:
#   <BNOS_CLOUDINARY_FOLDER>/bnos/<orgId|anonymous>/<purpose>
BNOS_CLOUDINARY_CLOUD_NAME=
BNOS_CLOUDINARY_API_KEY=
BNOS_CLOUDINARY_API_SECRET=
BNOS_CLOUDINARY_UPLOAD_PRESET=
BNOS_CLOUDINARY_FOLDER=bnos

# ── Public Nostr relay defaults ─────────────────────────────────────────────
# Optional comma-separated list used for new/ reset relay configurations.
# This value is exposed to the browser, so do not put secrets here.
# PUBLIC_RELAYS=wss://relay.example.com,wss://relay.example.org
PUBLIC_RELAYS=

# ── Owner / system notices ──────────────────────────────────────────────────
# Optional allow-list of owner npubs (npub1… or 64-char hex, comma-separated).
# These keys may publish in-app notices (alerts, security, updates) as kind-1
# notes tagged #bnos; BNOS also accepts extra keys the user trusts locally in
# Settings → Notifications. Exposed to the browser — npubs are public keys, so
# never put secrets here.
#   Example post: kind 1, tags [["t","bnos.space-security"],["t","critical"]]
#   See docs/owner-notices.md for the full tag scheme.
# This allow-list is also where encrypted user feedback (bug reports / feature
# requests) is delivered; when it is empty BNOS falls back to the built-in
# project support npub in src/lib/site.ts.
# PUBLIC_OWNER_NPUBS=npub1abc…,npub1def…
PUBLIC_OWNER_NPUBS=
